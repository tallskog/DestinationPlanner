<Window x:Class="DestinationPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DestinationPlanner.ViewModels"
        xmlns:views="clr-namespace:DestinationPlanner.Views"
        Title="MSFS 2024 Flight Logbook"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Logbook…"           Command="{Binding Logbook.OpenCommand}"/>
                <MenuItem Header="_Save Logbook…"           Command="{Binding Logbook.SaveCommand}"/>
                <Separator/>
                <MenuItem Header="_Import Foreign Logbook…" Command="{Binding Logbook.ImportCommand}"/>
                <Separator/>
                <MenuItem Header="Load _Airport Data…"      Click="LoadAirportData_Click"/>
                <Separator/>
                <MenuItem Header="E_xit"                    Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <TabControl>
            <TabItem Header="Map">
                <views:MapView DataContext="{Binding Map}"/>
            </TabItem>
            <TabItem Header="Logbook">
                <views:LogbookView DataContext="{Binding Logbook}"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
