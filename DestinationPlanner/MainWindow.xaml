<Window x:Class="DestinationPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DestinationPlanner.Views"
        Title="MSFS 2024 Flight Logbook"
        Icon="DestinationPlanner.ico"
        Height="700" Width="1100"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SimStatus}" FontSize="11"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="UpdateBadge"
                        Content="⬆ Update ready — click to restart"
                        FontSize="11"
                        Foreground="White"
                        Background="#1F8B1F"
                        BorderThickness="0"
                        Padding="8,2"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="UpdateBadge_Click"/>
            </StatusBarItem>
        </StatusBar>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Logbook…"           Command="{Binding Logbook.OpenLogbookCommand}"/>
                <Separator/>
                <MenuItem Header="_Import Logbook…"         Command="{Binding Logbook.ImportNativeCommand}"/>
                <MenuItem Header="_Export Logbook…"         Command="{Binding Logbook.ExportCommand}"/>
                <Separator/>
                <MenuItem Header="Import _Foreign Logbook…" Command="{Binding Logbook.ImportForeignCommand}"/>
                <Separator/>
                <MenuItem Header="Load _Airport Data…"      Click="LoadAirportData_Click"/>
                <MenuItem Header="_Download Airport Data"   Click="DownloadAirportData_Click"/>
                <Separator/>
                <MenuItem Header="Update Airport _Type Data (OpenAIP)…" Click="UpdateOpenAipAirportTypes_Click"/>
                <Separator/>
                <MenuItem Header="Configure _AI…"           Click="ConfigureAi_Click"/>
                <MenuItem Header="_Plan a Trip…"            Click="PlanTrip_Click"/>
                <Separator/>
                <MenuItem Header="E_xit"                    Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _Updates…" Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Header="_About…" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <TabControl x:Name="MainTabs">
            <TabItem Header="Map">
                <views:MapView DataContext="{Binding Map}"/>
            </TabItem>
            <TabItem Header="Logbook">
                <views:LogbookView DataContext="{Binding Logbook}"/>
            </TabItem>
            <TabItem x:Name="TripPlanTab" Header="Trip Plans">
                <views:TripPlanView DataContext="{Binding TripPlan}"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
