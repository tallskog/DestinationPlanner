<Window x:Class="DestinationPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DestinationPlanner.Views"
        Title="MSFS 2024 Flight Logbook"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SimStatus}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import Logbook…"         Command="{Binding Logbook.ImportNativeCommand}"/>
                <MenuItem Header="_Export Logbook…"         Command="{Binding Logbook.ExportCommand}"/>
                <Separator/>
                <MenuItem Header="Import _Foreign Logbook…" Command="{Binding Logbook.ImportForeignCommand}"/>
                <Separator/>
                <MenuItem Header="Load _Airport Data…"      Click="LoadAirportData_Click"/>
                <Separator/>
                <MenuItem Header="E_xit"                    Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <TabControl>
            <TabItem Header="Map">
                <views:MapView DataContext="{Binding Map}"/>
            </TabItem>
            <TabItem Header="Logbook">
                <views:LogbookView DataContext="{Binding Logbook}"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
