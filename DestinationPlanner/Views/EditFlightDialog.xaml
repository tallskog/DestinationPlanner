<Window x:Class="DestinationPlanner.Views.EditFlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Flight"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Content="Type:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding AircraftTypeOptions}"
                  SelectedItem="{Binding AircraftType}"
                  Margin="0,4"/>

        <Label Grid.Row="1" Content="Aircraft:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding AircraftModel, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,4"/>

        <Label Grid.Row="2" Content="From:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding DepartureIcao, UpdateSourceTrigger=PropertyChanged}"
                 CharacterCasing="Upper" Margin="0,4"/>

        <Label Grid.Row="3" Content="To:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding ArrivalIcao, UpdateSourceTrigger=PropertyChanged}"
                 CharacterCasing="Upper" Margin="0,4"/>

        <Label Grid.Row="4" Content="Block Off (UTC):" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <DatePicker SelectedDate="{Binding BlockOffDate}" Width="130"/>
            <TextBox Text="{Binding BlockOffTime, UpdateSourceTrigger=PropertyChanged}"
                     Width="55" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Label Grid.Row="5" Content="Block On (UTC):" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <DatePicker SelectedDate="{Binding BlockOnDate}" Width="130"/>
            <TextBox Text="{Binding BlockOnTime, UpdateSourceTrigger=PropertyChanged}"
                     Width="55" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"
                    IsEnabled="{Binding IsValid}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
