<Window x:Class="DestinationPlanner.Views.NavigraphSignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Navigraph"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">

        <StackPanel x:Name="StartingPanel">
            <TextBlock Text="Connecting to Navigraph…" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
            <TextBlock Text="Enter this code at the address below to sign in:" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding UserCode}" FontSize="26" FontWeight="Bold"
                       FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding VerificationUri}" FontSize="11" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Open Browser" Command="{Binding OpenBrowserCommand}" Padding="10,3" Margin="0,0,8,0"/>
                <Button Content="Copy Code" Command="{Binding CopyCodeCommand}" Padding="10,3"/>
            </StackPanel>
            <TextBlock Text="Waiting for you to approve in your browser…"
                       Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Padding="10,3"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C82828" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Center" Padding="10,3"/>
        </StackPanel>

    </Grid>
</Window>
