<Window x:Class="DestinationPlanner.Views.FlightLegMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="Flight Leg Map"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,5">
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
        </Border>

        <Grid>
            <TextBlock x:Name="EmptyStateText"
                       Text="Airport data not available for this leg."
                       FontStyle="Italic" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <mapsui:MapControl x:Name="MapCtrl"/>
            <!-- Not hit-test-collapsed, matching TripMapWindow/CandidateMapWindow — see
                 CLAUDE.md's "Map info box parity" rule and requirements.md's BUG-12. Every
                 purely-decorative child is individually IsHitTestVisible="False" instead. -->
            <Canvas x:Name="RouteOverlay" ClipToBounds="True">

                <Line x:Name="PrimaryLeaderLine"   IsHitTestVisible="False" Stroke="#1E78C8" StrokeThickness="1.5" Visibility="Collapsed"/>
                <Line x:Name="SecondaryLeaderLine" IsHitTestVisible="False" Stroke="#DC6400" StrokeThickness="1.5" Visibility="Collapsed"/>

                <Border x:Name="PrimaryInfoBox"
                        IsHitTestVisible="True" Cursor="SizeAll"
                        Background="White" BorderBrush="#1E78C8" BorderThickness="1.5"
                        CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="PrimaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                        <TextBlock x:Name="PrimaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                        <StackPanel x:Name="PrimaryRunwaysList" Margin="0,0,0,6"/>
                        <Separator Margin="0,0,0,4"/>
                        <TextBlock x:Name="PrimaryMetar" FontSize="10" Foreground="#555"
                                   TextWrapping="Wrap" MaxWidth="260"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SecondaryInfoBox"
                        IsHitTestVisible="True" Cursor="SizeAll"
                        Background="White" BorderBrush="#DC6400" BorderThickness="1.5"
                        CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="SecondaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                        <TextBlock x:Name="SecondaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                        <StackPanel x:Name="SecondaryRunwaysList" Margin="0,0,0,6"/>
                        <Separator Margin="0,0,0,4"/>
                        <TextBlock x:Name="SecondaryMetar" FontSize="10" Foreground="#555"
                                   TextWrapping="Wrap" MaxWidth="260"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
