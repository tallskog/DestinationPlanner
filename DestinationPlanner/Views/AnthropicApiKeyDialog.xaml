<Window x:Class="DestinationPlanner.Views.AnthropicApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure AI (Claude)"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
            Enter your Anthropic API key to enable AI-assisted trip planning. Create a key at
            <Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate">console.anthropic.com</Hyperlink>.
            This is optional — the app works normally without it.
        </TextBlock>

        <TextBox x:Name="ApiKeyBox" Margin="0,0,0,4"/>

        <TextBlock Text="Saved to anthropic.local.json in the app's AppData folder — never committed to source control."
                   FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save"   Width="80" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
