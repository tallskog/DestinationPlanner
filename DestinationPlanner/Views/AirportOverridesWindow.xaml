<Window x:Class="DestinationPlanner.Views.AirportOverridesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Airport Overrides"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Every airport you've manually corrected or hidden. Right-click (or double-click) a row to edit it, or use Clear Override to reset it back to the detected value."/>

        <Button DockPanel.Dock="Bottom" Content="Close" Width="80" HorizontalAlignment="Right"
                Margin="0,8,0,0" IsDefault="True" Click="Close_Click"/>

        <Grid>
            <TextBlock x:Name="EmptyText" Text="No airport overrides yet — right-click an airport on any map to add one."
                       Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <DataGrid x:Name="OverridesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit..." Click="Edit_Click"/>
                        <MenuItem Header="Clear Override" Click="Clear_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ICAO" Binding="{Binding Icao}" Width="70"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="220"/>
                    <DataGridTextColumn Header="Overridden fields" Binding="{Binding Summary}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
