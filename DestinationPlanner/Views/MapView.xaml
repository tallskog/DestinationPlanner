<UserControl x:Class="DestinationPlanner.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left filter sidebar -->
        <DockPanel Grid.Column="0" Margin="4,4,2,4">

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding AirportDataStatus}"
                       Margin="4,0,4,6"
                       FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>

            <GroupBox DockPanel.Dock="Top" Header="Runway Length" Margin="0,0,0,4" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Min:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2"
                             Text="{Binding MinRunway, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Max:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2"
                             Text="{Binding MaxRunway, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Values in metres"
                              IsChecked="{Binding UseMeters}"
                              Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox DockPanel.Dock="Top" Header="Capabilities" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <CheckBox IsChecked="{Binding RequireInstrumentApproach}" Margin="0,0,0,3">
                        <TextBlock Text="Instrument approach (ILS)" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RequireAtis}">
                        <TextBlock Text="ATIS" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </GroupBox>

            <GroupBox DockPanel.Dock="Top" Header="Visit Status" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <CheckBox IsChecked="{Binding ShowVisited}"    Content="Show visited airports"     Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowNotVisited}" Content="Show not-visited airports"/>
                </StackPanel>
            </GroupBox>

            <GroupBox DockPanel.Dock="Top" Header="Radius Filter" Margin="0,0,0,4" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Centre:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2"
                             Text="{Binding FilterCenterIcao, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="Radius (nm):" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2"
                             Text="{Binding FilterRadiusNm, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox DockPanel.Dock="Top" Header="ICAO Filter" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <TextBox Text="{Binding IcaoPrefixes, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Prefixes, comma-separated&#x0a;e.g. EF,ES for Finland &amp; Sweden"/>
                </StackPanel>
            </GroupBox>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Apply Filters" Command="{Binding ApplyFiltersCommand}" Padding="10,3"/>
                <Button Content="Clear"         Command="{Binding ClearFiltersCommand}" Padding="10,3" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="MapStatus" DockPanel.Dock="Bottom"
                       Margin="4,8,4,0" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Map area with flight status bar -->
        <DockPanel Grid.Column="1">

            <!-- Flight status bar docked to the bottom of the map area -->
            <Border DockPanel.Dock="Bottom"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="0,1,0,0"
                    Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SimStatusText}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SimConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#1F8B1F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FlightInfoText}" FontSize="11" Foreground="#333333"/>
                </StackPanel>
            </Border>

            <!-- Map + selection overlay stacked -->
            <Grid>
                <mapsui:MapControl x:Name="MapCtrl"/>
                <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False"/>
            </Grid>

        </DockPanel>

        <!-- Primary airport popup (left-click) -->
        <Popup x:Name="PrimaryPopup"
               Grid.Column="1"
               StaysOpen="True"
               AllowsTransparency="True"
               Placement="RelativePoint"
               PlacementTarget="{Binding ElementName=MapCtrl}">
            <Border Background="White" BorderBrush="#1E78C8" BorderThickness="1.5"
                    CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="PrimaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                    <TextBlock x:Name="PrimaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                    <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                    <StackPanel x:Name="PrimaryRunwaysList" Margin="0,0,0,6"/>
                    <Separator Margin="0,0,0,4"/>
                    <TextBlock x:Name="PrimaryMetar" FontSize="10" Foreground="#555"
                               TextWrapping="Wrap" MaxWidth="260"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Secondary airport popup (Ctrl+left-click) -->
        <Popup x:Name="SecondaryPopup"
               Grid.Column="1"
               StaysOpen="True"
               AllowsTransparency="True"
               Placement="RelativePoint"
               PlacementTarget="{Binding ElementName=MapCtrl}">
            <Border Background="White" BorderBrush="#DC6400" BorderThickness="1.5"
                    CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="SecondaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                    <TextBlock x:Name="SecondaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                    <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                    <StackPanel x:Name="SecondaryRunwaysList" Margin="0,0,0,6"/>
                    <Separator Margin="0,0,0,4"/>
                    <TextBlock x:Name="SecondaryMetar" FontSize="10" Foreground="#555"
                               TextWrapping="Wrap" MaxWidth="260"/>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</UserControl>
