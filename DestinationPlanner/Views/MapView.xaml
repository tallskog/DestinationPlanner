<UserControl x:Class="DestinationPlanner.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left filter sidebar -->
        <DockPanel Grid.Column="0" Margin="4,4,2,4">

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding AirportDataStatus}"
                       Margin="4,0,4,6"
                       FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>

            <!-- Pinned above the scrollable filter list so Apply/Clear stay reachable
                 without resizing the window, however many filter groups are added later. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Apply Filters" Command="{Binding ApplyFiltersCommand}" Padding="10,3"/>
                <Button Content="Clear"         Command="{Binding ClearFiltersCommand}" Padding="10,3" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="MapStatus" DockPanel.Dock="Bottom"
                       Margin="4,8,4,0" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>

            <!-- Remaining filter groups + legend scroll independently, filling whatever
                 vertical space is left between the pinned buttons above and status below. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

            <GroupBox Header="Runway Length" Margin="0,0,0,4" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Min:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2"
                             Text="{Binding MinRunway, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Max:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2"
                             Text="{Binding MaxRunway, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="Values in metres"
                              IsChecked="{Binding UseMeters}"
                              Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Capabilities" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <CheckBox IsChecked="{Binding RequireInstrumentApproach}" Margin="0,0,0,3">
                        <TextBlock Text="Instrument approach (ILS)" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RequireAtis}">
                        <TextBlock Text="ATIS" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Airport Type" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <CheckBox IsChecked="{Binding ShowCivilAirports}"        Content="Civil"        Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowMilitaryAirports}"     Content="Military"     Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowHeliportAirports}"     Content="Heliport"     Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowPrivateAirports}"      Content="Private"      Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowOtherAirports}"        Content="Other / Special-Use" Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowUnknownAirports}"      Content="Unknown"      Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowUnclassifiedAirports}" Content="Unclassified" Margin="0,0,0,5"/>
                    <TextBlock FontSize="9" Foreground="Gray" TextWrapping="Wrap">
                        Airport type data: <Hyperlink NavigateUri="https://www.openaip.net"
                                                       RequestNavigate="Attribution_RequestNavigate">openAIP</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Visit Status" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <CheckBox IsChecked="{Binding ShowVisited}"    Content="Show visited airports"     Margin="0,0,0,3"/>
                    <CheckBox IsChecked="{Binding ShowNotVisited}" Content="Show not-visited airports"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Radius Filter" Margin="0,0,0,4" Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Centre:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="4,2"
                             Text="{Binding FilterCenterIcao, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="Radius (nm):" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4,2"
                             Text="{Binding FilterRadiusNm, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="ICAO Filter" Margin="0,0,0,4" Padding="6,4">
                <StackPanel>
                    <TextBox Text="{Binding IcaoPrefixes, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"/>
                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Prefixes, comma-separated&#x0a;e.g. EF,ES for Finland &amp; Sweden"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Map Legend" Margin="0,2,0,4" Padding="6,4">
                <StackPanel>

                    <!-- Unvisited airport: plain amber dot -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="9" Height="9" Fill="#FFC107"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Unvisited airport" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Visited airport: plain orange dot -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="9" Height="9" Fill="#DC6400"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Visited airport" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Departed from: orange dot + green ring -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="18" Height="18" Fill="Transparent"
                                     Stroke="#28C83C" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="9" Height="9" Fill="#DC6400"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Departed from" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Landed at: orange dot + red ring -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="18" Height="18" Fill="Transparent"
                                     Stroke="#C82828" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="9" Height="9" Fill="#DC6400"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Landed at" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Both departed and landed: orange dot + green inner ring + red outer ring -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="20" Height="20" Fill="Transparent"
                                     Stroke="#C82828" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="13" Height="13" Fill="Transparent"
                                     Stroke="#28C83C" StrokeThickness="2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="6" Height="6" Fill="#DC6400"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Departed and landed" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Map area with flight status bar -->
        <DockPanel Grid.Column="1">

            <!-- Flight status bar docked to the bottom of the map area -->
            <Border DockPanel.Dock="Bottom"
                    Background="#F5F5F5"
                    BorderBrush="#CCCCCC"
                    BorderThickness="0,1,0,0"
                    Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SimStatusText}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SimConnected}" Value="True">
                                        <Setter Property="Foreground" Value="#1F8B1F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FlightInfoText}" FontSize="11" Foreground="#333333"/>
                </StackPanel>
            </Border>

            <!-- Map + selection overlay stacked -->
            <Grid>
                <mapsui:MapControl x:Name="MapCtrl"/>
                <!-- Deliberately no IsHitTestVisible="False" here: that would suppress hit
                     testing for the *entire* subtree, including children explicitly marked
                     True (proven out — a WPF ancestor's False cannot be overridden by a
                     descendant's True). The Canvas has no Background, so its own empty area
                     is never itself hit; every purely-decorative child below is instead
                     marked IsHitTestVisible="False" individually so only the two draggable
                     info boxes intercept clicks — everything else still passes clicks
                     through to the map underneath, same as before. -->
                <Canvas x:Name="SelectionOverlay" ClipToBounds="True">

                    <!-- Leader lines: only shown once the matching info box below has been
                         dragged away from its default anchor position, so the user never
                         loses track of which airport a relocated box belongs to. -->
                    <Line x:Name="PrimaryLeaderLine"   IsHitTestVisible="False" Stroke="#1E78C8" StrokeThickness="1.5" Visibility="Collapsed"/>
                    <Line x:Name="SecondaryLeaderLine" IsHitTestVisible="False" Stroke="#DC6400" StrokeThickness="1.5" Visibility="Collapsed"/>

                    <!-- Primary airport info box (left-click). Draggable. -->
                    <Border x:Name="PrimaryInfoBox"
                            IsHitTestVisible="True" Cursor="SizeAll"
                            Background="White" BorderBrush="#1E78C8" BorderThickness="1.5"
                            CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="PrimaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                            <TextBlock x:Name="PrimaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                            <StackPanel x:Name="PrimaryRunwaysList" Margin="0,0,0,6"/>
                            <Separator Margin="0,0,0,4"/>
                            <TextBlock x:Name="PrimaryMetar" FontSize="10" Foreground="#555"
                                       TextWrapping="Wrap" MaxWidth="260"/>
                        </StackPanel>
                    </Border>

                    <!-- Secondary airport info box (Ctrl+left-click). -->
                    <Border x:Name="SecondaryInfoBox"
                            IsHitTestVisible="True" Cursor="SizeAll"
                            Background="White" BorderBrush="#DC6400" BorderThickness="1.5"
                            CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="SecondaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                            <TextBlock x:Name="SecondaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                            <StackPanel x:Name="SecondaryRunwaysList" Margin="0,0,0,6"/>
                            <Separator Margin="0,0,0,4"/>
                            <TextBlock x:Name="SecondaryMetar" FontSize="10" Foreground="#555"
                                       TextWrapping="Wrap" MaxWidth="260"/>
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Weather overlay controls (top-left corner) — deliberately not part of
                     the filter sidebar; this toggles a map layer, not an airport filter.
                     Precip and Wind share one row so they read as a single "weather" group. -->
                <StackPanel x:Name="WeatherContainer"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="10,10,0,0">
                    <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="3"
                            HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <ToggleButton x:Name="PrecipitationToggleButton" Content="🌧 Precip"
                                          Checked="PrecipitationToggle_Checked" Unchecked="PrecipitationToggle_Unchecked"
                                          Padding="8,4" FontSize="12"/>
                            <Button x:Name="PrecipitationRefreshButton" Content="⟳"
                                    Click="PrecipitationRefresh_Click"
                                    IsEnabled="False"
                                    Padding="6,4" FontSize="12" Margin="4,0,0,0"
                                    ToolTip="Refresh to the current radar frame"/>
                            <Rectangle Width="1" Fill="#CCCCCC" Margin="8,2,8,2"/>
                            <ToggleButton x:Name="WindToggleButton" Content="🎏 Wind"
                                          Checked="WindToggle_Checked" Unchecked="WindToggle_Unchecked"
                                          Padding="8,4" FontSize="12"/>
                            <Button x:Name="WindRefreshButton" Content="⟳"
                                    Click="WindRefresh_Click"
                                    IsEnabled="False"
                                    Padding="6,4" FontSize="12" Margin="4,0,0,0"
                                    ToolTip="Refresh wind barbs for the current view"/>
                            <ComboBox x:Name="WindFlightLevelCombo"
                                      SelectionChanged="WindFlightLevelCombo_SelectionChanged"
                                      Width="130" Margin="6,0,0,0" FontSize="12"
                                      DisplayMemberPath="Label"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="4,2,0,0">
                        <TextBlock x:Name="PrecipitationStatusText" FontSize="10" Foreground="Gray"/>
                        <TextBlock x:Name="WindStatusText" FontSize="10" Foreground="Gray" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="PrecipitationAttributionText" FontSize="9" Foreground="Gray" Margin="4,2,0,0"
                               Visibility="Collapsed">
                        Radar: <Hyperlink NavigateUri="https://www.rainviewer.com"
                                          RequestNavigate="Attribution_RequestNavigate">RainViewer</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="WindAttributionText" FontSize="9" Foreground="Gray" Margin="4,0,0,0"
                               Visibility="Collapsed">
                        Wind: <Hyperlink NavigateUri="https://open-meteo.com"
                                         RequestNavigate="Attribution_RequestNavigate">Open-Meteo</Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Search box overlay (top-right corner) -->
                <Grid x:Name="SearchContainer"
                      VerticalAlignment="Top" HorizontalAlignment="Right"
                      Margin="0,10,10,0" Width="260">
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Background="White" BorderBrush="#AAAAAA"/>
                            <TextBlock Text="Search airport…"
                                       IsHitTestVisible="False"
                                       Foreground="#BBBBBB" FontStyle="Italic"
                                       Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="SearchDropdown"
                                Background="White" BorderBrush="#AAAAAA" BorderThickness="1,0,1,1"
                                Visibility="Collapsed" MaxHeight="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <ListBox x:Name="SearchResultsList"
                                     ItemsSource="{Binding SearchResults}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" Margin="0,2">
                                            <Run FontWeight="SemiBold" Text="{Binding Icao, Mode=OneWay}"/>
                                            <Run Text=" – "/>
                                            <Run Foreground="#666666" Text="{Binding Name, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

        </DockPanel>

    </Grid>
</UserControl>
