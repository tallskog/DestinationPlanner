<Window x:Class="DestinationPlanner.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logbook Statistics"
        Width="480" MinHeight="300" MaxHeight="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <TextBlock x:Name="EmptyStateText"
                   Text="No flights logged yet."
                   FontStyle="Italic" Foreground="Gray"
                   Visibility="Collapsed"/>

        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Overview" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="TotalFlightsText" Margin="0,0,0,2"/>
                <TextBlock x:Name="VisitedAirportsText" Margin="0,0,0,2"/>
                <TextBlock x:Name="SpanText" Margin="0,0,0,12"/>

                <TextBlock Text="Airports" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock Text="Most visited" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ItemsControl x:Name="TopVisitedList" Margin="8,0,0,6"/>
                <TextBlock Text="Most landed at" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ItemsControl x:Name="TopLandedList" Margin="8,0,0,6"/>
                <TextBlock Text="Most departed from" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ItemsControl x:Name="TopDepartedList" Margin="8,0,0,12"/>

                <TextBlock Text="Routes" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock Text="Most common routes" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ItemsControl x:Name="TopRoutesList" Margin="8,0,0,12"/>

                <TextBlock Text="Legs" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="LongestByDistanceText" Margin="0,0,0,2"/>
                <TextBlock x:Name="LongestByTimeText" Margin="0,0,0,2"/>
                <TextBlock x:Name="AverageDistanceText" Margin="0,0,0,2"/>
                <TextBlock x:Name="AverageTimeText" Margin="0,0,0,2"/>
                <TextBlock x:Name="TotalDistanceText" Margin="0,0,0,2"/>
                <TextBlock x:Name="TotalTimeText" Margin="0,0,0,12"/>

                <TextBlock Text="Aircraft" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <ItemsControl x:Name="AircraftList" Margin="8,0,0,12"/>

                <Button Content="Close" Width="80" HorizontalAlignment="Right"
                        Margin="0,4,0,0" IsCancel="True" IsDefault="True"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
