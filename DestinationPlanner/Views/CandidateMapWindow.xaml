<Window x:Class="DestinationPlanner.Views.CandidateMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="Candidate Airports"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Click an airport for details."
                           FontSize="10" Foreground="Gray" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid>
            <mapsui:MapControl x:Name="MapCtrl"/>
            <!-- Not hit-test-collapsed — the draggable info box below needs to receive clicks.
                 Background left unset (null, not Transparent) so empty canvas area still lets
                 clicks/drags reach MapCtrl underneath. See CLAUDE.md's "Map info box parity"
                 rule and requirements.md's BUG-12 for why this can't rely on a Canvas-level
                 IsHitTestVisible="False" instead. -->
            <Canvas x:Name="MarkerOverlay" ClipToBounds="True">

                <!-- Leader line: only shown once the info box below has been dragged away from
                     its default anchor position (mirrors MapView's SelectionOverlay). -->
                <Line x:Name="PrimaryLeaderLine" IsHitTestVisible="False" Stroke="#1E78C8" StrokeThickness="1.5" Visibility="Collapsed"/>

                <!-- Airport info box. Draggable — see DraggableInfoBox / MapView's
                     PrimaryInfoBox for the pattern. Only one box — a flat candidate list has no
                     "pair" concept the way a trip leg's two endpoints do, so no secondary box. -->
                <Border x:Name="PrimaryInfoBox"
                        IsHitTestVisible="True" Cursor="SizeAll"
                        Background="White" BorderBrush="#1E78C8" BorderThickness="1.5"
                        CornerRadius="3" Padding="10,7" MinWidth="160" MaxWidth="280"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="PrimaryIcao" FontWeight="Bold" FontSize="13" Margin="0,0,0,1"/>
                        <TextBlock x:Name="PrimaryName" TextWrapping="Wrap" MaxWidth="260" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="Runways" FontSize="10" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,2"/>
                        <StackPanel x:Name="PrimaryRunwaysList" Margin="0,0,0,6"/>
                        <Separator Margin="0,0,0,4"/>
                        <TextBlock x:Name="PrimaryMetar" FontSize="10" Foreground="#555"
                                   TextWrapping="Wrap" MaxWidth="260"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
