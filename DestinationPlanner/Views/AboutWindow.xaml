<Window x:Class="DestinationPlanner.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About DestinationPlanner"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="DestinationPlanner" FontSize="18" FontWeight="Bold"/>
        <TextBlock x:Name="VersionText" FontSize="11" Foreground="Gray" Margin="0,2,0,12"/>

        <TextBlock Text="External data sources" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <StackPanel Margin="0,0,0,10">
            <TextBlock><Hyperlink NavigateUri="https://ourairports.com" RequestNavigate="Hyperlink_RequestNavigate">OurAirports</Hyperlink></TextBlock>
            <TextBlock Text="Airport, runway, and frequency master data (airports.csv / runways.csv / airport-frequencies.csv)."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
            <TextBlock><Hyperlink NavigateUri="https://www.openaip.net" RequestNavigate="Hyperlink_RequestNavigate">OpenAIP</Hyperlink></TextBlock>
            <TextBlock Text="Airport type classification (e.g. distinguishing heliports and seaplane bases from airports), used to refine map filtering. Requires a free API key."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
            <TextBlock><Hyperlink NavigateUri="https://open-meteo.com" RequestNavigate="Hyperlink_RequestNavigate">Open-Meteo</Hyperlink></TextBlock>
            <TextBlock Text="Wind speed and direction at a chosen flight level, for the wind barb overlay."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
            <TextBlock><Hyperlink NavigateUri="https://www.rainviewer.com" RequestNavigate="Hyperlink_RequestNavigate">RainViewer</Hyperlink></TextBlock>
            <TextBlock Text="Precipitation radar frames (rain, snow, sleet, hail) for the map overlay."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
            <TextBlock><Hyperlink NavigateUri="https://aviationweather.gov" RequestNavigate="Hyperlink_RequestNavigate">Aviation Weather Center (NOAA)</Hyperlink></TextBlock>
            <TextBlock Text="Live METAR reports shown for the selected departure/arrival airports."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
            <TextBlock><Hyperlink NavigateUri="https://www.openstreetmap.org" RequestNavigate="Hyperlink_RequestNavigate">OpenStreetMap</Hyperlink></TextBlock>
            <TextBlock Text="Base map tiles. © OpenStreetMap contributors."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <Button Content="Close" Width="80" HorizontalAlignment="Right"
                Margin="0,4,0,0" IsCancel="True" IsDefault="True"/>
    </StackPanel>
</Window>
