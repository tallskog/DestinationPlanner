<UserControl x:Class="DestinationPlanner.Views.TripPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- Query panel -->
        <GroupBox DockPanel.Dock="Top" Header="Plan a Trip" Margin="6,6,6,0" Padding="6,4">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    Describe the trip you want, e.g. "airports in northern Europe with a 9000ft+
                    runway I haven't visited yet".
                </TextBlock>
                <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Start ICAO (optional):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding StartIcao, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" CharacterCasing="Upper" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Generate Candidates" Command="{Binding GenerateCommand}" Padding="10,3" Margin="0,0,8,0"/>
                    <Button Content="Confirm &amp; Plan Trip" Command="{Binding ConfirmCommand}" Padding="10,3"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="DimGray"/>
                <TextBlock Foreground="Gray" FontStyle="Italic" Margin="0,4,0,0" Visibility="Collapsed"
                           Text="Configure an Anthropic API key (File → Configure AI…) to enable trip planning.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAiConfigured}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Candidates -->
            <GroupBox Header="Candidate Airports" Grid.Column="0" Margin="6">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="Remove Selected"
                            Command="{Binding RemoveSelectedCandidateCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,3"/>
                    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                             DisplayMemberPath="Icao"/>
                </DockPanel>
            </GroupBox>

            <!-- Saved plans + legs -->
            <Grid Grid.Column="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Saved Trip Plans" Grid.Row="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <TextBlock Text="Original query:" FontSize="10" Foreground="Gray"/>
                            <TextBox Text="{Binding SelectedPlan.Query, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"
                                     Background="#F5F5F5" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Reuse Query" Command="{Binding ReuseQueryCommand}" Padding="8,3"/>
                                <Button Content="Delete Plan" Command="{Binding DeleteSelectedPlanCommand}" Padding="8,3" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SavedPlans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Title"/>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="Legs" Grid.Row="1" Margin="0,6,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Mark Selected Leg Flown"
                                    Command="{Binding MarkLegFlownCommand}"
                                    Padding="8,3"/>
                            <Button x:Name="ViewOnMapButton" Content="View on Map"
                                    Click="ViewOnMap_Click"
                                    Padding="8,3" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPlan}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <DataGrid x:Name="LegsGrid" ItemsSource="{Binding SelectedPlanLegs}" SelectedItem="{Binding SelectedLeg}"
                                  SelectionMode="Extended" SelectionChanged="LegsGrid_SelectionChanged"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"             Binding="{Binding Order}"         Width="30"/>
                                <DataGridTextColumn Header="From"          Binding="{Binding DepartureIcao}" Width="70"/>
                                <DataGridTextColumn Header="To"            Binding="{Binding ArrivalIcao}"   Width="70"/>
                                <DataGridTextColumn Header="Distance (nm)" Binding="{Binding DistanceNm, StringFormat='{}{0:N0}'}" Width="100"/>
                                <DataGridTextColumn Header="Status"        Binding="{Binding Status}"         Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
